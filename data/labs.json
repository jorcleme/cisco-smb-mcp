        "title": "Configure SNMP Trap Receiver",
        "description": "Configure trap receiver for event notifications",
        "commands": ["snmp-server host 192.168.1.100 version 3 monitor1"],
        "expected_output": "Trap receiver configured",
        "verification": "Traps should be sent to specified host",
        "hints": ["Replace IP with your management station IP"]
      },
      {
        "step_number": 4,
        "title": "Test SNMP Connectivity",
        "description": "Test SNMP polling from management station",
        "commands": [],
        "expected_output": "SNMP queries return device information",
        "verification": "Management station receives SNMP responses",
        "hints": ["Use snmpwalk or snmpget from management station"]
      }
    ],
    "validation": {
      "commands": ["show snmp", "show snmp user", "show snmp host"],
      "expected_results": [
        "SNMP service is enabled",
        "SNMPv3 user exists with SHA auth",
        "Trap receiver configured"
      ]
    },
    "troubleshooting": [
      {
        "issue": "SNMP queries timing out",
        "solution": "Verify firewall rules allow UDP port 161, check community/user credentials"
      },
      {
        "issue": "No traps received",
        "solution": "Verify trap receiver IP address, check UDP port 162 is open"
      }
    ],
    "completion_criteria": [
      "SNMPv3 user configured with authentication",
      "SNMP queries successful from management station",
      "Traps received at management station",
      "Security best practices followed"
    ]
  }
]
