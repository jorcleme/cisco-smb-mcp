{
  "name": "mcp-document-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for document and prompt management",
  "main": "dist/server/server.js",
  "type": "module",
  "bin": {
    "mcp-document-server": "./dist/server/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/client/client.js dist/server/server.js",
    "dev": "tsx src/server/server.ts src/client/client.ts",
    "watch": "tsx watch src/server/server.ts",
    "test": "npx tsx src/client/simple-client.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "documents",
    "prompts"
  ],
  "author": "Jordan Clemens",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.58.0",
    "@modelcontextprotocol/sdk": "^1.17.1",
    "dotenv": "^17.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
